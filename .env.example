# Copy this file to .env and fill in the blanks. .env is never committed.
#
# Settings with a sensible default are commented out below, with the default shown.
# Uncomment one only to override it. Leaving a name uncommented with an empty value
# sets it to an empty string, which is not the same as leaving it unset.

# --- Local Postgres -----------------------------------------------------------
# Read by docker-compose.yml. These are baked in when the container first initializes
# its data directory, so changing them later needs `docker compose down -v` first.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# --- Application --------------------------------------------------------------
# Read by the settings module. Must agree with the four values above, or you get an
# authentication failure that looks like a code bug.
# Shape: postgresql://USER:PASSWORD@localhost:PORT/DBNAME
DATABASE_URL=

# Required. Ollama ignores whatever it is sent, so any non-empty placeholder works for
# local development. A hosted provider needs the real key.
MODEL_API_KEY=

# --- Optional overrides -------------------------------------------------------
# MODEL_NAME=qwen3.5:9b
# MODEL_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=5
# RRF_K=60
# LOG_LEVEL=INFO
# LOG_FORMAT=console
